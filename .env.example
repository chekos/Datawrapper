# Copy this file to .env and add local configuration values as needed.
# Never commit .env or credentials.

# Required to create/update/publish charts and to run the functional,
# end-to-end tests in tests/functional/. Get a token from your Datawrapper
# account settings: https://app.datawrapper.de/account/api-tokens
DATAWRAPPER_ACCESS_TOKEN=

# Optional: only needed for custom TLS/proxy setups.
# PYTHONHTTPSVERIFY=
# SSL_CERT_FILE=
# REQUESTS_CA_BUNDLE=
